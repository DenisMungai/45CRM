DATABASE_SSL=true
APP_URL=https://45crm.vercel.app
DB_POOL_MAX=10
SESSION_SECRET=hghjjuytfffdscpojjht
SESSION_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=admin@45creatives.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_URL=
# Optional approved template for business-initiated agreement delivery. Use body parameters:
# {{1}} client name, {{2}} project name, {{3}} signing URL.
WHATSAPP_AGREEMENT_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Documenso (optional) - sends both the provider and client a parallel Documenso envelope of the
# already-generated contract PDF purely to collect a certified, independently auditable e-signature.
# It runs alongside the app's own signing flow above, which stays the primary way agreements are
# created, signed, and delivered. Create an API token under Settings > API Tokens in Documenso.
DOCUMENSO_API_KEY=
# Only needed for a self-hosted Documenso instance, e.g. https://sign.yourdomain.com/api/v2
DOCUMENSO_API_URL=
# Set the same value on the webhook you add in Documenso (pointing at
# ${APP_URL}/api/webhooks/documenso, subscribed to at least DOCUMENT_COMPLETED) so this app can
# verify incoming events actually came from Documenso.
DOCUMENSO_WEBHOOK_SECRET=

# Google Analytics 4 (optional) - powers the "Website Traffic" panel on the Reports
# tab (sessions, active users, conversions from 45creatives.co.ke). Create a GA4
# service account in Google Cloud Console, grant it "Viewer" access on your GA4
# property (Admin > Property Access Management), then fill these in:
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
